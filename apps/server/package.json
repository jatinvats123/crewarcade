{
  "name": "@crewarcade/server",
  "version": "0.1.0",
  "private": true,
  "description": "CrewArcade API, Nexconn webhooks, job queue, AI agents and playtest worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "measure:pixel": "tsx --env-file-if-exists=.env scripts/measure-pixel.ts",
    "stream:repro": "tsx --env-file-if-exists=.env scripts/stream-repro.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@crewarcade/engine": "workspace:*",
    "@crewarcade/shared": "workspace:*",
    "@google/genai": "3.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "gifenc": "1.0.3",
    "nanoid": "5.1.16",
    "pg-boss": "12.38.2",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "undici": "7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.7",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
