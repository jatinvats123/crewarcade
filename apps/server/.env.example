# CrewArcade server environment. Copy to apps/server/.env (gitignored) for local dev.
# In production these live in the Render dashboard. NEVER commit real values.
# Service keys are optional in development (the server starts and /health works without them)
# and REQUIRED when NODE_ENV=production (the server refuses to start).

# development | test | production
NODE_ENV=development
# Port to listen on (Render sets PORT itself).
PORT=8080
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Supabase Postgres. Use the transaction pooler URL (port 6543) from
# Supabase > Project Settings > Database > Connection string. Required.
# Local alternative: postgres://postgres:postgres@localhost:5432/crewarcade
DATABASE_URL=
# Max connections in this process's pool.
DATABASE_POOL_MAX=10

# Origin of the web app (CORS allow-list, agent avatar URLs, share links).
WEB_ORIGIN=http://localhost:3000
# Public origin of this server (webhook URL to paste in the Nexconn console = PUBLIC_API_ORIGIN/webhooks/nexconn).
PUBLIC_API_ORIGIN=http://localhost:8080

# Nexconn (console.nexconn.ai > Key Management). The App Secret signs every server API call. Server only.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore data center API, primary + backup (automatic failover).
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_API_BACKUP=https://api-b.sg-light-api.com

# Supabase Storage (buckets: clips public, uploads private, games private). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for Pixel, Forge and Glitch. Server only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Sarvam AI (Hindi/Hinglish speech-to-text for voice pitches and bug reports). Server only.
SARVAM_API_KEY=

# 32 random bytes, base64, to encrypt stored Nexconn access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Signs the session cookie (HS256). At least 32 random characters. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Secure flag on the session cookie (default: true in production, false otherwise).
COOKIE_SECURE=
# Reject webhooks whose Timestamp is further than this from now (ms). The signature does not cover
# the body, so freshness is what stops replayed headers.
WEBHOOK_MAX_SKEW_MS=600000

# Global daily AI spend cap in USD; builds pause for the day once reached.
DAILY_BUDGET_USD=25
# Run pg-boss workers (job queue + playtests) in this process: true | false
RUN_WORKERS=true
