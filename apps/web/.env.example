# CrewArcade web environment. Copy to apps/web/.env.local (gitignored) for local dev.
# In production these live in the Vercel dashboard.
# ONLY NEXT_PUBLIC_* variables belong here, and none may be a secret: everything NEXT_PUBLIC_ is
# shipped to every browser. The Nexconn App Secret, Supabase service key, Anthropic and Sarvam keys
# live ONLY in apps/server/.env / Render. CI fails if they appear in web code.

# CrewArcade server origin (Render). Used at BUILD time as the target of the /api/* proxy rewrite
# (next.config.ts): the browser itself only calls this site's origin. Redeploy after changing it.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
# This site's public origin (share links, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. The browser gets the Nexconn App Key from POST /api/nexconn/token, so this can stay empty.
# (Public by design if set; NEVER the App Secret.)
NEXT_PUBLIC_NEXCONN_APP_KEY=
