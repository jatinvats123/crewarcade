{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crewarcade/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crewarcade/server",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crewarcade/web",
        "exec",
        "next",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "local-stack",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crewarcade/server",
        "exec",
        "tsx",
        "scripts/local-stack.ts"
      ],
      "port": 8080
    }
  ]
}